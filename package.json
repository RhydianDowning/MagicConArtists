{
  "name": "painters-servant",
  "version": "1.0.0",
  "description": "Find which artists from an event have illustrated cards in your MTG decklists",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron electron/main.js",
    "dev": "electronmon .",
    "test": "node --test tests/*.test.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "build": {
    "appId": "com.paintersservant.app",
    "productName": "Painters Servant",
    "files": [
      "electron/**/*",
      "src/**/*",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "artistLists",
        "to": "artistLists"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "devDependencies": {
    "electron": "35.1.2",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4"
  },
  "electronmon": {
    "patterns": [
      "!localStorage/**"
    ]
  }
}
